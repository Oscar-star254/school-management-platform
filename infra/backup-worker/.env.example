# Use the Payload API's HTTPS base URL ending in /api (never the Vercel frontend URL).
BACKUP_API_URL=https://payload.example.com/api
BACKUP_WORKER_TOKEN=replace-with-at-least-32-random-characters

# Dedicated PostgreSQL connection for the worker. Must access the complete application database.
BACKUP_DATABASE_URL=postgresql://backup_user:replace-me@db.example.com:5432/school?sslmode=require
BACKUP_RESTORE_ROLE=replace-with-database-owner-role

# Cloudflare R2 S3-compatible credentials; the bucket must remain private.
R2_ACCOUNT_ID=replace-me
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET_NAME=school-backups

# Public recipient from age-keygen; the matching private identity is mounted as a host secret.
BACKUP_AGE_RECIPIENT=age1replace-with-public-recipient

# Daily schedule uses this IANA timezone; default for this school deployment is EAT.
BACKUP_TIMEZONE=Africa/Nairobi
BACKUP_POLL_SECONDS=15
BACKUP_TMPFS_SIZE=16g
BACKUP_ALERT_WEBHOOK_URL=https://alerts.example.com/your-webhook
BACKUP_RESTORE_ENABLED=false
